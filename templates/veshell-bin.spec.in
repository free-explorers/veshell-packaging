# Veshell binary RPM.
#
# Generated at release time by scripts/gen-bin-recipes.py from
# templates/veshell-bin.spec.in. Do not edit by hand.
#
# Installs the prebuilt payload published on the GitHub release
# (veshell-<release>-x86_64.tar.zst). Prefer the source spec
# (fedora/veshell.spec) when you want a fully verifiable source build.
#
# Builds on Fedora (COPR) and openSUSE (OBS). Runtime dependencies differ per
# distribution: Fedora names on one branch, openSUSE names on the other, and
# openSUSE relies on its automatic shared-library dependency generation.

%global debug_package %{nil}
%global prebuilt_sha256 @PREBUILT_SHA256@
%{!?_userunitdir:%global _userunitdir %{_prefix}/lib/systemd/user}

Name:           veshell-bin
Version:        @RPM_VERSION@
Release:        @RPM_RELEASE@%{?dist}
Summary:        An innovative Not-Desktop environment for Linux built with Flutter and Rust
License:        GPL-3.0-or-later
URL:            https://github.com/free-explorers/veshell
Source0:        @PREBUILT_URL@
ExclusiveArch:  x86_64

Provides:       veshell = %{version}-%{release}
Conflicts:      veshell

%if 0%{?suse_version}
# openSUSE: shared-library requirements are generated automatically from the
# packaged ELF objects, so only the non-library runtime pieces are listed here.
Requires:       dbus-1
Requires:       fontconfig
Requires:       google-noto-sans-cjk-fonts
Requires:       google-noto-sans-fonts
Requires:       google-roboto-fonts
Requires:       gstreamer-plugins-base
Requires:       gstreamer-plugins-good
Requires:       pipewire-pulseaudio
Requires:       polkit
Requires:       upower
Requires:       xdg-desktop-portal
Requires:       xdg-utils
Requires:       xwayland

Recommends:     NetworkManager
Recommends:     bluez
Recommends:     rtkit
Recommends:     xdg-desktop-portal-gtk
%else
Requires:       fontconfig
Requires:       google-roboto-fonts
Requires:       google-noto-sans-fonts
Requires:       google-noto-sans-arabic-fonts
Requires:       google-noto-sans-bengali-fonts
Requires:       google-noto-sans-devanagari-fonts
Requires:       google-noto-sans-cjk-fonts
Requires:       mesa-libgbm
Requires:       libglvnd
Requires:       libinput
Requires:       libseat
Requires:       libdisplay-info
Requires:       libxkbcommon
Requires:       systemd-libs
Requires:       pipewire
Requires:       pulseaudio-libs
Requires:       gstreamer1
Requires:       gstreamer1-plugins-base
Requires:       gstreamer1-plugins-good
Requires:       dbus
Requires:       upower
Requires:       polkit
Requires:       xorg-x11-server-Xwayland
Requires:       xdg-desktop-portal
Requires:       xdg-utils

Recommends:     NetworkManager
Recommends:     bluez
Recommends:     rtkit
Recommends:     xdg-desktop-portal-gtk
%endif

BuildRequires:  zstd

%description
Veshell is an innovative Not-Desktop environment for Linux made with modern
technologies like Flutter and Rust. This package installs the prebuilt payload
published on the GitHub release; it does not build from source.

%prep
%setup -q -T -c -n veshell-bin-%{version}
printf '%s  %s\n' '%{prebuilt_sha256}' '%{SOURCE0}' | sha256sum -c -
zstd -dc '%{SOURCE0}' | tar -xf - -C .

%build

%install
mkdir -p %{buildroot}
cp -a usr %{buildroot}/

%files
/usr/bin/veshell
/usr/bin/veshell-session
/usr/bin/veshell-session-stop
/usr/lib/veshell/
/usr/share/veshell/
/usr/share/wayland-sessions/veshell.desktop
/usr/share/xdg-desktop-portal/veshell-portals.conf
/usr/share/xdg-desktop-portal/portals/veshell.portal
%{_userunitdir}/veshell.service
%{_userunitdir}/veshell-shutdown.target
%license /usr/share/licenses/veshell/LICENSE

%changelog
* @DATE_RPM@ @MAINTAINER@ - @RPM_VERSION@-@RPM_RELEASE@
- Veshell @RELEASE_ID@ (@CHANNEL@).
