#!/usr/bin/make -f
# Debian source package rules for Veshell.
#
# Generated from templates/debian/rules.in by
# scripts/render-recipes.py. Do not edit by hand.
#
# The hermetic build is shared with the Arch and Fedora recipes through
# debian/build-veshell.sh (a copy of scripts/build-veshell.sh).
#
# Because Flutter is not packaged in Debian, the pinned upstream inputs are
# supplied out of band and are NOT part of the uploaded source package. Point
# VESHELL_INPUT_DIR at a directory holding:
#   flutter_linux_3.47.7-stable.tar.xz
#   flutter_patched_sdk.zip
#   flutter_patched_sdk_product.zip
#   linux-x64_artifacts.zip
#   linux-x64-debug_flutter-gtk.zip
#   linux-x64-profile_flutter-gtk.zip
#   linux-x64-release_flutter-gtk.zip
#   linux-engine-sdk-release-x86_64-deb287481e3ce9468f3434937ced4240a70539ca.tar.gz
#   veshell-cargo-vendor-0.1.5.tar.zst
#   veshell-pubcache-0.1.5.tar.zst
# See README.md for why this blocks a Debian main upload.

include /usr/share/dpkg/default.mk

# This silences Debian's C LTO, and only that. dpkg-buildflags would add -flto
# to CFLAGS; the libspa-sys build script would then compile a C shim into GCC LTO
# objects, which rustc's final link cannot resolve because it does not pass -flto
# to the linker. The Rust code is optimized separately with ThinLTO through
# Cargo's [profile.release].
export DEB_BUILD_OPTIONS := $(DEB_BUILD_OPTIONS) nolto

VESHELL_INPUT_DIR ?= $(CURDIR)/debian/inputs
FLUTTER_SDK_DIR   := $(CURDIR)/debian/.build-inputs/flutter-sdk
CARGO_VENDOR_DIR  := $(CURDIR)/debian/.build-inputs/cargo-vendor
PUB_CACHE_DIR     := $(CURDIR)/debian/.build-inputs/pubcache
ENGINE_TARBALL    := $(VESHELL_INPUT_DIR)/linux-engine-sdk-release-x86_64-deb287481e3ce9468f3434937ced4240a70539ca.tar.gz

export VESHELL_SRC := $(CURDIR)
export PREFIX := /usr

%:
	dh $@

override_dh_auto_configure:
	rm -rf debian/.build-inputs
	mkdir -p $(FLUTTER_SDK_DIR) $(CARGO_VENDOR_DIR) $(PUB_CACHE_DIR)
	tar -xJf $(VESHELL_INPUT_DIR)/flutter_linux_3.47.7-stable.tar.xz \
		-C $(FLUTTER_SDK_DIR) --strip-components=1
	tar -xf $(VESHELL_INPUT_DIR)/veshell-cargo-vendor-0.1.5.tar.zst -C $(CARGO_VENDOR_DIR)
	tar -xf $(VESHELL_INPUT_DIR)/veshell-pubcache-0.1.5.tar.zst -C $(PUB_CACHE_DIR)

override_dh_auto_build:
	FLUTTER_SDK_DIR=$(FLUTTER_SDK_DIR) \
	FLUTTER_ARTIFACT_DIR=$(VESHELL_INPUT_DIR) \
	ENGINE_TARBALL=$(ENGINE_TARBALL) \
	CARGO_VENDOR_DIR=$(CARGO_VENDOR_DIR) \
	PUB_CACHE_DIR=$(PUB_CACHE_DIR) \
	POLKIT_HELPER_PATH=/usr/lib/polkit-1/polkit-agent-helper-1 \
	VESHELL_BUILD_COMMIT=f63384e3a0d68b62428c810f1a6463e11b444a46 \
	VESHELL_BUILD_CHANNEL=beta \
	PREFIX=/usr JOBS=$$(nproc) \
	bash debian/build-veshell.sh build

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/veshell bash debian/build-veshell.sh install

override_dh_auto_test:
	@echo "no upstream test suite is run during package build"

override_dh_auto_clean:
	rm -rf debian/.build-inputs
	dh_auto_clean
